# MySQL connection used by Prisma. Replace the placeholders with your local values.
DATABASE_URL="mysql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:3306/YOUR_DATABASE"

# API server
PORT=5050
NODE_ENV=development
# Leave blank locally; set to the exact website address in production.
CLIENT_ORIGIN=

# Optional: leave blank to use Pantry's local recipe suggestions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Initial account sign-in. Use a long, private password and random secret in production.
PANTRY_ACCESS_PASSWORD=replace-with-a-long-private-password
PANTRY_SESSION_SECRET=replace-with-a-long-random-secret
DEFAULT_USER_NAME=My kitchen
DEFAULT_USER_EMAIL=owner@pantry.local
